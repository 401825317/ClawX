{
  "provider": {
    "productionOrigin": "https://aiwxxx.com",
    "providerName": "UClaw",
    "managedProviderId": "openai",
    "compatibilityProviderId": "lingzhiwuxian",
    "managedAccountId": "openai",
    "authAccountId": "uclaw-auth",
    "managedRuntimeContractVersion": 5,
    "legacyAuthAccountIds": ["lingzhiwuxian-auth"],
    "defaultModel": "smart-latest",
    "defaultFallbackModel": "deepseek-v4-flash",
    "defaultModelContextWindow": 258000,
    "defaultApiProtocol": "openai-responses",
    "defaultThinkingLevel": "off",
    "requestTimeoutSeconds": 300
  },
  "auth": {
    "requestTimeoutMs": 12000,
    "bootstrapRequestTimeoutMs": 8000,
    "relayRequestTimeoutMs": 12000,
    "verificationRequestTimeoutMs": 12000,
    "offlineGraceSeconds": 604800,
    "verifyMemoryCacheSeconds": 300,
    "tokenRefreshSkewSeconds": 300,
    "defaultAccessTokenLifetimeSeconds": 86400
  },
  "marketplace": {
    "defaultProvider": "skillhub",
    "skillHubApiOrigin": "https://api.skillhub.cn",
    "skillHubWebOrigin": "https://skillhub.cn",
    "clawHubConvexOrigin": "https://wry-manatee-359.convex.cloud",
    "clawHubMirrorOrigin": "https://mirror-cn.clawhub.com",
    "clawHubInstallOrigin": "https://clawhub.ai",
    "requestTimeoutMs": 15000,
    "downloadTimeoutMs": 90000,
    "maxJsonBytes": 4194304,
    "maxDownloadBytes": 33554432,
    "maxArchiveFiles": 512,
    "maxArchiveEntryBytes": 16777216,
    "maxArchiveUncompressedBytes": 67108864
  },
  "billing": {
    "requestTimeoutMs": 12000,
    "orderStatusPollIntervalMs": 2000,
    "historyPageSize": 20,
    "routes": {
      "overview": "/api/clawx/billing/checkout-info",
      "orders": "/api/clawx/billing/orders",
      "history": "/api/clawx/billing/orders/history",
      "verify": "/api/clawx/billing/orders/verify"
    }
  },
  "support": {
    "requestTimeoutMs": 8000,
    "refreshIntervalMs": 600000,
    "routes": {
      "clientConfig": "/api/clawx/client-config",
      "bootstrap": "/api/clawx/bootstrap"
    }
  },
  "updates": {
    "checkTimeoutMs": 30000,
    "downloadTimeoutMs": 1800000,
    "routes": {
      "feed": "/api/clawx/updates/feed",
      "latest": "/api/clawx/updates/latest"
    }
  },
  "runtimeDefaults": {
    "tools": {
      "exec": {
        "security": "full",
        "ask": "off"
      }
    },
    "compaction": {
      "mode": "safeguard",
      "reserveTokensFloor": 50000
    }
  },
  "media": {
    "image": {
      "timeoutMs": 900000,
      "defaultSize": "1024x1024"
    },
    "video": {
      "providerId": "uclaw-video",
      "apiProtocol": "openai-completions",
      "timeoutMs": 900000,
      "pollIntervalMs": 5000,
      "requestTimeoutMs": 15000,
      "contentDownloadAttemptTimeoutMs": 60000,
      "contentDownloadMaxAttempts": 4,
      "maxDownloadBytes": 134217728,
      "maxInputImageBytes": 1048576,
      "defaultModel": "grok-image-video",
      "defaultAspectRatio": "16:9",
      "defaultResolution": "480P",
      "defaultDurationSeconds": 6,
      "resolutionSizes": {
        "480P": "854x480",
        "720P": "1280x720"
      },
      "models": [
        {
          "id": "grok-image-video",
          "label": "Grok Video",
          "description": "Text-to-video model used when no reference image is provided.",
          "modes": ["text-to-video"],
          "aspectRatios": ["2:3", "3:2", "1:1", "9:16", "16:9"],
          "resolutions": ["480P", "720P"],
          "durations": [6, 10, 15],
          "defaultAspectRatio": "16:9",
          "defaultResolution": "480P",
          "defaultDurationSeconds": 6,
          "requiresImage": false
        },
        {
          "id": "grok-video-1.5",
          "label": "Grok Video 1.5",
          "description": "Image-to-video model that requires one reference image.",
          "modes": ["image-to-video"],
          "aspectRatios": ["2:3", "3:2", "1:1", "9:16", "16:9"],
          "resolutions": ["480P", "720P"],
          "durations": [6, 10, 15],
          "defaultAspectRatio": "16:9",
          "defaultResolution": "480P",
          "defaultDurationSeconds": 6,
          "requiresImage": true
        }
      ]
    },
    "testTimeoutMs": 900000,
    "clientTimeoutBufferMs": 10000
  }
}
